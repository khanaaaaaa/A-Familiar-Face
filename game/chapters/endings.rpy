label ending_together:

    call screen chapter_title("05", "We Go Back")

    scene bg black
    with fade

    pause 1.0

    scene bg auditorium
    with dissolve

    narrator "The auditorium is exactly as you left it."
    narrator "The gravestone is still standing."

    minju "Hey."
    minju "I'm sorry I left."
    minju "I think about it every year."

    narrator "The lights flicker."
    narrator "Then the carving fades."
    narrator "Slowly."
    narrator "Until the stone is black."
    mc "..."
    minju "..."
    narrator "minju exhales."
    minju "Thank you for coming back with me."
    mc "Obviously."
    narrator "She laughs."
    
    scene bg black
    with fade

    pause 1.5

    centered "{size=24}{i}She wasn't alone this time{/i}{/size}"

    pause 2.0

    return

label ending_apart:

    call screen chapter_title("05", "Some Things Stay")

    scene bg black
    with fade

    pause 1.0

    scene bg school
    with dissolve

    narrator "We don't go back."
    narrator "The decorations come down the next day."
    narrator "The auditorium goes back to being just a room."
    narrator "minju is quieter than usual."

    mc "minju."

    minju "Hm."

    mc "You okay?"

    minju "Yeah."

    narrator "She's not."
    narrator "I know that."
    narrator "She knows I know."

    narrator "Some things don't get ressolved."
    narrator "They just get carried."

    scene bg black
    with fade

    pause 1.5

    centered "{size=24}{i}She still thinks about her.{/i}{/size}"

    pause 2.0

    return

label ending_peace:

    call screen chapter_title("05", "Enough")

    scene bg black
    with fade

    pause 1.0

    scene bg hallway
    with dissolve

    narrator "We stand there a little longer."
    narrator "Then minju straightens up."

    minju "Come on."

    mc "Where?"

    minju "Home."

    narrator "We walk out together."
    narrator "The rain has stopped."
    narrator "The courtyard is wet and quiet."
    narrator "The paper moon is still hanging over the entrance."

    minju "Next year, they'll put up different decorations."

    mc "Probably."

    minju "Good."

    narrator "She doesn't look back."
    narrator "Neither do I."

    scene bg black
    with fade

    pause 1.5

    centered "{size=24}{i}That was enough.{/i}{/size}"

    pause 2.0

    return